// 樱花：粉紫玻璃底、人物与樱花装饰的展示主题。底与装饰图都是浅色画的，所以锁定浅色。
// 窗口左内边距 60 是给人物身体与吊牌留的位置，改人物位置或大小时一起改。
{
  "extends": "qingjian",
  "schema": 1,
  "meta": { "id": "sakura", "name": "樱花", "author": "青简", "license": "GPL-3.0-or-later", "appearance": "light" },

  "variables": {
    "text": "#47344f",
    "text_hl": "#c54f98",
    "index": "#aa89b2",
    "index_hl": "#c75a9f",
    "gloss": "#ab8bb7",
    "fresh": "#d46fa8",
    "faint": "#c3a9cc",
    "cloud": "#8e7bd6",
    "ink": "#62486e",
    "ui": "#806289",
    "line": "#dab4db",
    "divider": "#e6d3ec"
  },

  "text": {
    "family": "system",
    "styles": {
      "candidate": { "size": 17, "line_height": 22, "family": ["Songti SC", "SimSun", "system"] },
      "annotation": { "size": 13, "line_height": 16 },
      "index": { "size": 13, "line_height": 22 },
      "preedit": { "size": 17, "line_height": 22 },
      "ui": { "size": 13, "line_height": 17 },
      "slogan": { "size": 11, "line_height": 16 },
      "tagline": { "size": 13, "line_height": 16, "family": ["Georgia", "system"], "style": "italic" },
      "small": { "size": 10, "line_height": 12 },
      "tag": { "size": 8, "line_height": 9, "family": ["Songti SC", "SimSun", "system"] },
      "status": { "size": 13, "line_height": 18 }
    }
  },

  "components": {
    "sakura-top": {
      "type": "frame", "padding": [2, 0, 6, 0], "align_self": "stretch",
      "children": [
        { "type": "preedit", "when": "preedit", "font": "preedit",
          "typed": "@ink", "rest": "#9c84a6", "struck": "@faint", "caret": { "width": 1.5, "color": "@ink" } },
        { "type": "frame", "when": "preedit", "width": 1, "height": 16, "fill": "@line", "margin": [3, 10, 0, 10] },
        { "type": "use", "component": "sakura-mode", "margin": [4, 0, 0, 0] },
        { "type": "frame", "when": "trailing", "margin": [4, 0, 0, 16], "children": [
          { "type": "icon", "icon": "cloud", "when": "trailing.cloud", "size": 13, "height": 16, "color": "@cloud", "margin": [0, 4, 0, 0] },
          { "type": "text", "bind": "trailing.text", "when": "trailing.cloud", "font": "ui", "color": "@cloud" },
          { "type": "text", "bind": "trailing.text", "when": "!trailing.cloud", "font": "ui", "color": "@ui" }
        ] },
        { "type": "frame", "when": "!trailing", "margin": [0, 0, 0, "auto"], "children": [
          { "type": "frame", "width": 9, "height": 9, "margin": [7, 8, 0, 16], "fill": { "image": "images/heart.svg" } },
          { "type": "frame", "width": 20, "height": 20, "margin": [1, 6, 0, 0], "fill": { "image": "images/cat.png" } },
          { "type": "text", "text": "与你，输入更可爱的世界", "font": "slogan", "color": "@ui", "margin": [4, 0, 0, 0] },
          { "type": "frame", "width": 9, "height": 9, "margin": [7, 0, 0, 8], "fill": { "image": "images/heart.svg" } }
        ] }
      ]
    },

    "sakura-mode": {
      "type": "frame", "children": [
        { "type": "frame", "when": "mode.scheme", "children": [
          { "type": "text", "bind": "mode.scheme", "font": "ui", "color": "@ui" },
          { "type": "text", "text": " · ", "font": "ui", "color": "@faint" }
        ] },
        { "type": "text", "text": "中", "when": "!mode.english", "font": "ui", "color": "@ui" },
        { "type": "text", "text": "英", "when": "mode.english", "font": "ui", "color": "@ui" },
        { "type": "text", "text": " · ", "font": "ui", "color": "@faint" },
        { "type": "text", "text": "简", "when": "!mode.traditional", "font": "ui", "color": "@ui" },
        { "type": "text", "text": "繁", "when": "mode.traditional", "font": "ui", "color": "@ui" }
      ]
    },

    "sakura-highlight": {
      "type": "frame", "id": "highlight", "transition": { "duration": 120, "easing": "ease-out" },
      "when": "highlighted", "position": "absolute", "inset": [0, 0, 0, 0], "radius": 11,
      "fill": { "linear": 170, "stops": ["#ffe9f7", "#f8cbe9"] },
      "border": { "width": 1.5, "color": "#ffffff" },
      "effects": [{ "type": "drop-shadow", "y": 2, "blur": 6, "color": "#e994c640" }]
    },

    "sakura-word": {
      "type": "frame", "children": [
        { "type": "icon", "icon": "cloud", "when": "cloud", "size": 13, "height": 22, "color": "@cloud", "margin": [0, 4, 0, 0] },
        { "type": "text", "bind": "text", "when": "cloud", "font": "candidate", "color": "@cloud" },
        { "type": "text", "bind": "text", "when": "!cloud", "font": "candidate",
          "color": { "if": "highlighted", "then": "@text_hl", "else": "@text" } },
        { "type": "text", "bind": "code", "when": "code", "font": "annotation", "color": "@gloss", "margin": [6, 0, 0, 3] }
      ]
    },

    // 词性、释义两行都定了高度：没有词性的候选（emoji）也占满两行，各格候选词对齐
    "sakura-item": {
      "type": "frame", "padding": [6, 12, 6, 10],
      "children": [
        { "type": "use", "component": "sakura-highlight" },
        { "type": "frame", "when": "!first", "position": "absolute", "inset": [10, "auto", 10, 0], "width": 1, "fill": "@divider" },
        { "type": "text", "bind": "index", "font": "index",
          "color": { "if": "highlighted", "then": "@index_hl", "else": "@index" }, "margin": [0, 6, 0, 0] },
        { "type": "frame", "direction": "column", "children": [
          { "type": "use", "component": "sakura-word" },
          { "type": "annotation", "bind": "annotation", "font": "annotation", "tones": ["pos"], "senses": 1, "height": 16,
            "gloss": "@gloss", "fresh": "@fresh", "faint": "@faint", "pos": "@gloss" },
          { "type": "annotation", "bind": "annotation", "font": "annotation", "tones": ["gloss", "fresh"], "senses": 1, "height": 16,
            "gloss": "@gloss", "fresh": "@fresh", "faint": "@faint" }
        ] }
      ]
    },

    "sakura-row": {
      "type": "frame",
      "children": [
        { "type": "frame", "id": "highlight", "transition": { "duration": 120, "easing": "ease-out" },
          "when": "highlighted", "span": "row", "margin": [1, -6, 1, -6], "radius": 10,
          "fill": { "linear": 170, "stops": ["#ffe9f7", "#f8cbe9"] },
          "border": { "width": 1.5, "color": "#ffffff" },
          "effects": [{ "type": "drop-shadow", "y": 2, "blur": 6, "color": "#e994c640" }] },
        { "type": "text", "bind": "index", "font": "index",
          "color": { "if": "highlighted", "then": "@index_hl", "else": "@index" }, "margin": [4, 0, 0, 0] },
        { "type": "use", "component": "sakura-word", "margin": [4, 0, 0, 8] },
        { "type": "annotation", "bind": "annotation", "when": "annotations", "font": "annotation", "senses": 2,
          "gloss": "@gloss", "fresh": "@fresh", "faint": "@faint", "margin": [8, 0, 0, 10] }
      ]
    },

    "sakura-pager": {
      "type": "frame", "when": "page", "margin": [6, 0, 0, "auto"], "padding": [10, 6, 10, 6], "radius": 10,
      "fill": "#ffffff80", "border": { "width": 1, "color": "#ead6ef" },
      "children": [
        { "type": "frame", "width": 14, "height": 14, "fill": { "image": "images/chevron-left.svg" } },
        { "type": "frame", "width": 1, "height": 14, "fill": "@divider", "margin": [0, 5, 0, 5] },
        { "type": "frame", "width": 14, "height": 14, "fill": { "image": "images/chevron-right.svg" } }
      ]
    },

    // gap 保证竖排窄窗口下两句不挤在一起
    "sakura-ribbon": {
      "type": "frame", "align_self": "stretch", "height": 20, "radius": 10, "gap": 16,
      "fill": { "linear": 90, "stops": ["#d99ecfa6", ["#ffe3f5a6", 0.5], "#dbb7e9a6"] },
      "children": [
        { "type": "text", "text": "Let’s type a happier story.", "font": "small", "color": "#a98ab1", "margin": [4, 0, 0, 10] },
        { "type": "text", "text": "Sakura types with you.", "font": "tagline", "color": "#ad83ad", "margin": [2, 12, 0, "auto"] }
      ]
    },

    "sakura-petal": {
      "type": "frame", "width": 18, "height": 11, "fill": { "image": "images/petal.svg" },
      "animation": { "duration": 3600, "easing": "ease-in-out",
        "keyframes": [{ "at": 0, "y": 0, "rotate": 0 }, { "at": 0.5, "y": 3, "rotate": 14 }, { "at": 1, "y": 0, "rotate": 0 }] }
    },

    // 吊牌上的「青简」是文字不是图，位置跟着人物图走
    "sakura-character": {
      "type": "frame", "position": "absolute", "inset": [-72, "auto", "auto", -24], "width": 137, "height": 150,
      "fill": { "image": "images/character.png", "scale": 2 },
      "children": [
        { "type": "frame", "direction": "column", "position": "absolute", "inset": [96, "auto", "auto", 31], "children": [
          { "type": "text", "text": "青", "font": "tag", "color": "#8c6a93" },
          { "type": "text", "text": "简", "font": "tag", "color": "#8c6a93" }
        ] }
      ]
    },

    "sakura-status-cell": {
      "type": "frame", "padding": [4, 6, 4, 6],
      "children": [
        { "type": "frame", "when": "first", "children": [
          { "type": "text", "text": "中", "when": "!mode.english", "font": "status", "color": "#705577" },
          { "type": "text", "text": "英", "when": "mode.english", "font": "status", "color": "#705577" },
          { "type": "frame", "width": 13, "height": 13, "margin": [3, 0, 0, 6], "fill": { "image": "images/moon.svg" } }
        ] },
        { "type": "frame", "when": "!first", "children": [
          { "type": "text", "bind": "text", "when": "!gear", "font": "status",
            "color": { "if": "emphasized", "then": "#705577", "else": "#b39abb" } }
        ] },
        { "type": "frame", "when": "gear", "width": 12, "height": 12, "margin": [3, 0, 0, 0], "fill": { "image": "images/chevron-right.svg" } }
      ]
    }
  },

  "windows": {
    "horizontal": {
      "type": "frame", "direction": "column", "padding": [10, 16, 8, 60], "min_width": 440, "radius": 18,
      "fill": { "linear": 180, "stops": [["#f9eeff", 0], ["#fff6fc", 0.55], ["#f2e7fa", 1]] },
      "border": { "width": 1.5, "color": "@line" },
      "effects": [
        { "type": "drop-shadow", "y": 6, "blur": 14, "color": "#b889b540" },
        { "type": "inner-shadow", "blur": 4, "color": "#ffffffcc" }
      ],
      "children": [
        { "type": "use", "component": "sakura-top" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "height": 1, "fill": "#ffffffe6" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "margin": [4, 0, 0, 0], "children": [
          { "type": "repeat", "bind": "candidates", "component": "sakura-item" },
          { "type": "use", "component": "sakura-pager" }
        ] },
        { "type": "use", "component": "sakura-ribbon", "margin": [8, -8, 0, -52] },

        { "type": "use", "component": "sakura-character" },
        { "type": "frame", "position": "absolute", "inset": [-12, -30, "auto", "auto"], "width": 56, "height": 84,
          "fill": { "image": "images/charm.png", "scale": 2 } },
        { "type": "frame", "position": "absolute", "inset": [-12, 36, "auto", "auto"], "width": 30, "height": 21,
          "fill": { "image": "images/bow.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-19, 190, "auto", "auto"], "width": 26, "height": 20,
          "fill": { "image": "images/crown.svg" } },
        { "type": "use", "component": "sakura-petal", "position": "absolute", "inset": [-7, "auto", "auto", 140] },
        { "type": "frame", "position": "absolute", "inset": ["auto", "auto", -14, 230], "width": 30, "height": 30,
          "fill": { "image": "images/blossom.png", "scale": 2 } },
        { "type": "frame", "position": "absolute", "inset": ["auto", 28, -9, "auto"], "width": 22, "height": 22,
          "fill": { "image": "images/blossom.png", "scale": 2 } },
        { "type": "use", "component": "sakura-petal", "position": "absolute", "inset": ["auto", "auto", -9, 110] },
        { "type": "frame", "position": "absolute", "inset": [-14, 236, "auto", "auto"], "width": 10, "height": 10,
          "fill": { "image": "images/sparkle.svg" } }
      ]
    },

    "vertical": {
      "type": "frame", "direction": "column", "padding": [10, 16, 8, 60], "min_width": 260, "radius": 18,
      "fill": { "linear": 180, "stops": [["#f9eeff", 0], ["#fff6fc", 0.55], ["#f2e7fa", 1]] },
      "border": { "width": 1.5, "color": "@line" },
      "effects": [
        { "type": "drop-shadow", "y": 6, "blur": 14, "color": "#b889b540" },
        { "type": "inner-shadow", "blur": 4, "color": "#ffffffcc" }
      ],
      "children": [
        { "type": "frame", "padding": [2, 0, 4, 0], "align_self": "stretch", "children": [
          { "type": "preedit", "when": "preedit", "font": "preedit",
            "typed": "@ink", "rest": "#9c84a6", "struck": "@faint", "caret": { "width": 1.5, "color": "@ink" } },
          { "type": "use", "component": "sakura-mode", "margin": [4, 0, 0, "auto"] }
        ] },
        { "type": "frame", "when": "trailing", "padding": [0, 0, 6, 0], "children": [
          { "type": "icon", "icon": "cloud", "when": "trailing.cloud", "size": 13, "height": 16, "color": "@cloud", "margin": [0, 4, 0, 0] },
          { "type": "text", "bind": "trailing.text", "when": "trailing.cloud", "font": "ui", "color": "@cloud" },
          { "type": "text", "bind": "trailing.text", "when": "!trailing.cloud", "font": "ui", "color": "@ui" }
        ] },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "height": 1, "fill": "#ffffffe6", "margin": [0, 0, 4, 0] },
        { "type": "frame", "when": "candidates", "table": { "row_height": 30 }, "align_self": "stretch", "children": [
          { "type": "repeat", "bind": "candidates", "component": "sakura-row" }
        ] },
        { "type": "text", "bind": "page", "font": "annotation", "color": "@gloss", "align_self": "end", "margin": [2, 0, 0, 0] },
        { "type": "use", "component": "sakura-ribbon", "margin": [6, -8, 0, -52] },

        { "type": "use", "component": "sakura-character" },
        { "type": "frame", "position": "absolute", "inset": [-10, -24, "auto", "auto"], "width": 44, "height": 66,
          "fill": { "image": "images/charm.png", "scale": 2 } },
        { "type": "frame", "position": "absolute", "inset": [-11, 30, "auto", "auto"], "width": 26, "height": 18,
          "fill": { "image": "images/bow.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-17, 86, "auto", "auto"], "width": 22, "height": 17,
          "fill": { "image": "images/crown.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-12, 116, "auto", "auto"], "width": 9, "height": 9,
          "fill": { "image": "images/sparkle.svg" } },
        { "type": "frame", "position": "absolute", "inset": ["auto", 24, -9, "auto"], "width": 22, "height": 22,
          "fill": { "image": "images/blossom.png", "scale": 2 } },
        { "type": "use", "component": "sakura-petal", "position": "absolute", "inset": ["auto", "auto", -8, 90] }
      ]
    }
  },

  // 点击按格分区（见 docs/design/theme.md「状态条」），伸出去的樱花点到算第一格
  "status": {
    "root": {
      "type": "frame", "padding": [3, 8, 3, 18], "radius": 13,
      "fill": { "linear": 170, "stops": ["#ffe9f7", "#f8cbe9"] },
      "border": { "width": 1, "color": "#ffffff" },
      "effects": [{ "type": "drop-shadow", "y": 3, "blur": 8, "color": "#b889b540" }],
      "children": [
        { "type": "frame", "position": "absolute", "inset": [-6, "auto", "auto", -14], "width": 34, "height": 34,
          "fill": { "image": "images/blossom.png", "scale": 2 } },
        { "type": "repeat", "bind": "cells", "component": "sakura-status-cell" }
      ]
    }
  }
}
