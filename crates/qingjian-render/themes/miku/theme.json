{
  "extends": "qingjian",
  "schema": 1,
  "meta": { "id": "miku", "name": "初音未来", "author": "青简", "license": "GPL-3.0-or-later AND LicenseRef-PCL", "appearance": "light" },

  "variables": {
    "text": "#142c3b",
    "index": "#95a1af",
    "index_hl": "#2b7f8a",
    "gloss": "#5d7383",
    "fresh": "#1fa8b8",
    "faint": "#a9b6c2",
    "cloud": "#27c9da",
    "ink": "#142c3b",
    "cyan": "#27c9da",
    "pink": "#f293c5",
    "divider": "#c6eef2",
    "icon": "#345768",
    "surface": "#f4fcfd",
    "accent": "#a9ebef"
  },

  "text": {
    "family": ["PingFang SC", "Microsoft YaHei", "system"],
    "styles": {
      "candidate": { "size": 18, "line_height": 24 },
      "annotation": { "size": 11, "line_height": 14 },
      "index": { "size": 15, "line_height": 24, "weight": "light" },
      "preedit": { "size": 19, "line_height": 26 },
      "ui": { "size": 12, "line_height": 16 },
      "number": { "size": 30, "line_height": 32, "weight": "light", "family": ["Avenir Next", "Segoe UI", "system"] },
      "status": { "size": 14, "line_height": 18, "weight": "semibold" }
    }
  },

  "components": {
    "miku-note": {
      "type": "frame", "width": 16, "height": 16, "fill": { "image": "images/music-note.svg" },
      "animation": { "duration": 2400, "easing": "ease-in-out",
        "keyframes": [{ "at": 0, "y": 0, "rotate": 0 }, { "at": 0.5, "y": -3, "rotate": -10 }, { "at": 1, "y": 0, "rotate": 0 }] }
    },

    "miku-mode": {
      "type": "frame", "children": [
        { "type": "frame", "when": "mode.scheme", "children": [
          { "type": "text", "bind": "mode.scheme", "font": "ui", "color": "@gloss" },
          { "type": "text", "text": " · ", "font": "ui", "color": "@faint" }
        ] },
        { "type": "text", "text": "中", "when": "!mode.english", "font": "ui", "color": "@gloss" },
        { "type": "text", "text": "英", "when": "mode.english", "font": "ui", "color": "@gloss" },
        { "type": "text", "text": " · ", "font": "ui", "color": "@faint" },
        { "type": "text", "text": "简", "when": "!mode.traditional", "font": "ui", "color": "@gloss" },
        { "type": "text", "text": "繁", "when": "mode.traditional", "font": "ui", "color": "@gloss" }
      ]
    },

    "miku-trailing": {
      "type": "frame", "children": [
        { "type": "icon", "icon": "cloud", "when": "trailing.cloud", "size": 13, "height": 16, "color": "@cloud", "margin": [0, 4, 0, 0] },
        { "type": "text", "bind": "trailing.text", "when": "trailing.cloud", "font": "ui", "color": "@cloud" },
        { "type": "text", "bind": "trailing.text", "when": "!trailing.cloud", "font": "ui", "color": "@gloss" }
      ]
    },

    "miku-preedit": {
      "type": "preedit", "font": "preedit", "typed": "@ink", "rest": "#6d8291", "struck": "@faint",
      "caret": { "width": 1.5, "color": "@cyan" }
    },

    "miku-highlight": {
      "type": "frame", "id": "highlight", "transition": { "duration": 120, "easing": "ease-out" },
      "when": "highlighted", "position": "absolute", "inset": [0, 0, 0, 0], "radius": 8,
      "fill": { "linear": 100, "stops": ["#92e3e9", "#a9ebef"] }
    },

    "miku-word": {
      "type": "frame", "children": [
        { "type": "icon", "icon": "cloud", "when": "cloud", "size": 14, "height": 24, "color": "@cloud", "margin": [0, 4, 0, 0] },
        { "type": "text", "bind": "text", "when": "cloud", "font": "candidate", "color": "@cloud" },
        { "type": "text", "bind": "text", "when": "!cloud", "font": "candidate", "color": "@text" },
        { "type": "text", "bind": "code", "when": "code", "font": "annotation", "color": "@gloss", "margin": [7, 0, 0, 3] }
      ]
    },

    "miku-gloss": {
      "type": "annotation", "bind": "annotation", "when": "annotation", "font": "annotation", "senses": 1,
      "tones": ["gloss", "fresh", "faint", "code"], "gloss": "@gloss", "fresh": "@fresh", "faint": "@faint"
    },

    "miku-item": {
      "type": "frame", "padding": [4, 10, 5, 8], "margin": [0, 4, 0, 0],
      "children": [
        { "type": "use", "component": "miku-highlight" },
        { "type": "text", "bind": "index", "font": "index",
          "color": { "if": "highlighted", "then": "@index_hl", "else": "@index" }, "margin": [0, 6, 0, 0] },
        { "type": "frame", "direction": "column", "children": [
          { "type": "use", "component": "miku-word" },
          { "type": "use", "component": "miku-gloss" }
        ] }
      ]
    },

    "miku-row": {
      "type": "frame", "padding": [3, 10, 4, 8], "align_self": "stretch",
      "children": [
        { "type": "use", "component": "miku-highlight" },
        { "type": "text", "bind": "index", "font": "index",
          "color": { "if": "highlighted", "then": "@index_hl", "else": "@index" }, "width": 12, "margin": [0, 10, 0, 0] },
        { "type": "frame", "direction": "column", "children": [
          { "type": "use", "component": "miku-word" },
          { "type": "use", "component": "miku-gloss" }
        ] },
        { "type": "frame", "when": "highlighted", "width": 13, "height": 13, "margin": [6, 0, 0, "auto"],
          "fill": { "image": "images/music-note.svg" } }
      ]
    },

    "miku-pager": {
      "type": "frame", "when": "page", "margin": [0, 0, 0, "auto"], "align_self": "center", "children": [
        { "type": "frame", "width": 16, "height": 16, "opacity": 0.5, "fill": { "image": "images/chevron-left.svg" } },
        { "type": "frame", "width": 16, "height": 16, "fill": { "image": "images/chevron-right.svg" } }
      ]
    },


    "miku-status-cell": {
      "type": "frame",
      "children": [
        { "type": "frame", "when": "first", "children": [
          { "type": "frame", "height": 26, "padding": [4, 6, 4, 6], "margin": [0, 2, 0, 2], "radius": 5, "fill": "@cyan", "children": [
            { "type": "text", "text": "中", "when": "!mode.english", "font": "status", "color": "#10414a" },
            { "type": "text", "text": "英", "when": "mode.english", "font": "status", "color": "#10414a" }
          ] },
          { "type": "frame", "height": 26, "padding": [4, 6, 4, 6], "margin": [0, 2, 0, 2], "children": [
            { "type": "frame", "width": 18, "height": 18, "fill": { "image": "images/moon.svg" } }
          ] }
        ] },
        { "type": "frame", "when": "!first", "children": [
          { "type": "frame", "when": "!gear", "children": [
            { "type": "frame", "height": 26, "padding": [4, 6, 4, 6], "margin": [0, 2, 0, 2], "children": [
              { "type": "text", "bind": "text", "font": "status",
                "color": { "if": "emphasized", "then": "@icon", "else": "#95a1af" } }
            ] },
            { "type": "frame", "height": 26, "padding": [4, 6, 4, 6], "margin": [0, 2, 0, 2], "children": [
              { "type": "frame", "width": 18, "height": 18, "fill": { "image": "images/keyboard.svg" } }
            ] }
          ] }
        ] },
        { "type": "frame", "when": "gear", "height": 26, "padding": [4, 6, 4, 6], "margin": [0, 2, 0, 2], "children": [
          { "type": "frame", "width": 18, "height": 18, "fill": { "image": "images/settings.svg" } }
        ] }
      ]
    }
  },

  "windows": {
    "horizontal": {
      "type": "frame", "direction": "column", "padding": [8, 20, 12, 18], "min_width": 400,
      "fill": { "image": "images/panel-horizontal.svg", "slice": [20, 50, 16, 14] },
      "effects": [{ "type": "drop-shadow", "y": 4, "blur": 10, "color": "#27c9da38" }],
      "children": [
        { "type": "frame", "padding": [2, 0, 5, 6], "align_self": "stretch", "children": [
          { "type": "use", "component": "miku-preedit", "when": "preedit" },
          { "type": "frame", "when": "preedit", "width": 1, "height": 16, "fill": "@divider", "margin": [5, 10, 0, 10] },
          { "type": "use", "component": "miku-mode", "margin": [5, 0, 0, 0] },
          { "type": "use", "component": "miku-trailing", "when": "trailing", "margin": [5, 0, 0, 14] },
          { "type": "frame", "width": 34, "height": 21, "margin": [2, 0, 0, "auto"], "fill": { "image": "images/corner-accent.svg" } },
          { "type": "frame", "width": 18, "height": 18, "margin": [6, 0, 0, -6], "fill": { "image": "images/equalizer.svg" } }
        ] },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "height": 1, "fill": "@divider", "margin": [0, 0, 0, 4] },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "margin": [5, 0, 0, 0], "children": [
          { "type": "repeat", "bind": "candidates", "component": "miku-item" },
          { "type": "use", "component": "miku-pager" }
        ] },

        { "type": "frame", "position": "absolute", "inset": [-65, -20, "auto", "auto"], "width": 190, "height": 77,
          "fill": { "image": "images/miku-top.png", "scale": 2 } },
        { "type": "use", "component": "miku-note", "position": "absolute", "inset": [-67, 186, "auto", "auto"] }
      ]
    },

    "vertical": {
      "type": "frame", "direction": "column", "padding": [12, 16, 12, 14], "min_width": 180,
      "fill": { "image": "images/panel-vertical.svg", "slice": [20, 50, 16, 14] },
      "effects": [{ "type": "drop-shadow", "y": 4, "blur": 10, "color": "#27c9da38" }],
      "children": [
        { "type": "frame", "padding": [2, 0, 2, 6], "align_self": "stretch", "children": [
          { "type": "use", "component": "miku-preedit", "when": "preedit" }
        ] },
        { "type": "frame", "padding": [0, 0, 5, 6], "align_self": "stretch", "children": [
          { "type": "use", "component": "miku-trailing", "when": "trailing" },
          { "type": "use", "component": "miku-mode", "margin": [0, 0, 0, "auto"] }
        ] },
        { "type": "frame", "when": "candidates", "direction": "column", "align_self": "stretch", "gap": 2, "children": [
          { "type": "repeat", "bind": "candidates", "component": "miku-row" }
        ] },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "margin": [2, 0, 0, 0], "children": [
          { "type": "text", "bind": "page", "font": "annotation", "color": "@gloss", "margin": [14, 0, 0, 8] },
          { "type": "text", "text": "01", "font": "number", "color": "@pink", "margin": [0, 2, 0, "auto"] }
        ] },

        { "type": "frame", "position": "absolute", "inset": [40, -117, "auto", "auto"], "width": 120, "height": 244,
          "fill": { "image": "images/miku-side.png", "scale": 2 } },
        { "type": "use", "component": "miku-note", "width": 20, "height": 20, "position": "absolute", "inset": [16, -40, "auto", "auto"] },
        { "type": "use", "component": "miku-note", "position": "absolute", "inset": [256, -96, "auto", "auto"] }
      ]
    }
  },

  // 点击按格分区，月亮算第一格、键盘算第二格；左边趴着的人物点到也算第一格
  "status": {
    "root": {
      "type": "frame", "padding": [6, 16, 6, 40],
      "fill": { "image": "images/panel-status.svg", "slice": [20, 50, 16, 14] },
      "effects": [{ "type": "drop-shadow", "y": 3, "blur": 8, "color": "#27c9da38" }],
      "children": [
        { "type": "frame", "position": "absolute", "inset": ["auto", "auto", -2, -104], "width": 140, "height": 57,
          "fill": { "image": "images/miku-sleep.png", "scale": 2 } },
        { "type": "use", "component": "miku-note", "position": "absolute", "inset": [-20, "auto", "auto", 26] },
        { "type": "repeat", "bind": "cells", "component": "miku-status-cell" }
      ]
    }
  }
}
