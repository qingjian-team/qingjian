{
  "extends": "qingjian",
  "schema": 1,
  "meta": { "id": "bocchi", "name": "波奇酱", "author": "青简", "license": "GPL-3.0-or-later AND LicenseRef-Character", "appearance": "light" },

  "variables": {
    "text": "#302632",
    "index": "#5a4a58",
    "gloss": "#8c6d7a",
    "fresh": "#d0607f",
    "faint": "#bfa6b0",
    "cloud": "#ef85a2",
    "ink": "#302632",
    "rose": "#d98d9e",
    "accent": "#ef85a2",
    "divider": "#f3d6dc",
    "surface": "#fff4f6"
  },

  "text": {
    "family": ["PingFang SC", "Microsoft YaHei", "system"],
    "styles": {
      "candidate": { "size": 17, "line_height": 23 },
      "annotation": { "size": 11.5, "line_height": 15 },
      "index": { "size": 14, "line_height": 23 },
      "preedit": { "size": 19, "line_height": 26 },
      "ui": { "size": 12, "line_height": 16 },
      "status": { "size": 15, "line_height": 18, "weight": "semibold" }
    }
  },

  "components": {
    "bocchi-layers": {
      "type": "frame", "position": "absolute", "inset": [3, 3, 3, 3], "radius": 17.5,
      "fill": { "linear": 170, "stops": ["#fffbf5", "#fff0e8"] },
      "border": { "width": 1, "color": "@rose" },
      "children": [
        { "type": "frame", "position": "absolute", "inset": [3.5, 3.5, 3.5, 3.5], "radius": 14,
          "border": { "width": 1.5, "color": "#ffe2e3" } }
      ]
    },

    "bocchi-note": {
      "type": "frame", "width": 15, "height": 15, "fill": { "image": "images/note.svg" },
      "animation": { "duration": 2600, "easing": "ease-in-out",
        "keyframes": [{ "at": 0, "y": 0, "rotate": 0 }, { "at": 0.5, "y": -3, "rotate": 10 }, { "at": 1, "y": 0, "rotate": 0 }] }
    },

    "bocchi-mode": {
      "type": "frame", "children": [
        { "type": "frame", "when": "mode.scheme", "children": [
          { "type": "text", "bind": "mode.scheme", "font": "ui", "color": "@gloss" },
          { "type": "text", "text": " · ", "font": "ui", "color": "@faint" }
        ] },
        { "type": "text", "text": "中", "when": "!mode.english", "font": "ui", "color": "@gloss" },
        { "type": "text", "text": "英", "when": "mode.english", "font": "ui", "color": "@gloss" },
        { "type": "text", "text": " · ", "font": "ui", "color": "@faint" },
        { "type": "text", "text": "简", "when": "!mode.traditional", "font": "ui", "color": "@gloss" },
        { "type": "text", "text": "繁", "when": "mode.traditional", "font": "ui", "color": "@gloss" }
      ]
    },

    "bocchi-trailing": {
      "type": "frame", "children": [
        { "type": "icon", "icon": "cloud", "when": "trailing.cloud", "size": 13, "height": 16, "color": "@cloud", "margin": [0, 4, 0, 0] },
        { "type": "text", "bind": "trailing.text", "when": "trailing.cloud", "font": "ui", "color": "@cloud" },
        { "type": "text", "bind": "trailing.text", "when": "!trailing.cloud", "font": "ui", "color": "@gloss" }
      ]
    },

    "bocchi-preedit": {
      "type": "preedit", "font": "preedit", "typed": "@ink", "rest": "#8c6d7a", "struck": "@faint",
      "caret": { "width": 2, "color": "@accent" }
    },

    "bocchi-highlight": {
      "type": "frame", "id": "highlight", "transition": { "duration": 120, "easing": "ease-out" },
      "when": "highlighted", "position": "absolute", "inset": [0, 0, 0, 0], "radius": 12,
      "fill": { "linear": 135, "stops": ["#fbc5d1", "#f8b8c9"] }
    },

    "bocchi-word": {
      "type": "frame", "children": [
        { "type": "icon", "icon": "cloud", "when": "cloud", "size": 14, "height": 23, "color": "@cloud", "margin": [0, 4, 0, 0] },
        { "type": "text", "bind": "text", "when": "cloud", "font": "candidate", "color": "@cloud" },
        { "type": "text", "bind": "text", "when": "!cloud", "font": "candidate", "color": "@text" },
        { "type": "text", "bind": "code", "when": "code", "font": "annotation", "color": "@gloss", "margin": [7, 0, 0, 3] }
      ]
    },

    "bocchi-gloss": {
      "type": "annotation", "bind": "annotation", "when": "annotation", "font": "annotation", "senses": 1,
      "tones": ["gloss", "fresh", "faint", "code"], "gloss": "@gloss", "fresh": "@fresh", "faint": "@faint"
    },

    "bocchi-item": {
      "type": "frame", "padding": [5, 12, 6, 10], "margin": [0, 5, 0, 0],
      "children": [
        { "type": "use", "component": "bocchi-highlight" },
        { "type": "text", "bind": "index", "font": "index", "color": "@index", "margin": [0, 6, 0, 0] },
        { "type": "frame", "direction": "column", "children": [
          { "type": "use", "component": "bocchi-word" },
          { "type": "use", "component": "bocchi-gloss" }
        ] }
      ]
    },

    "bocchi-row": {
      "type": "frame", "padding": [4, 12, 5, 10], "align_self": "stretch",
      "children": [
        { "type": "use", "component": "bocchi-highlight" },
        { "type": "text", "bind": "index", "font": "index", "color": "@index", "width": 12, "margin": [0, 8, 0, 0] },
        { "type": "frame", "direction": "column", "children": [
          { "type": "use", "component": "bocchi-word" },
          { "type": "use", "component": "bocchi-gloss" }
        ] }
      ]
    },

    "bocchi-page-previous": { "type": "icon", "icon": "chevron-left", "size": 9, "height": 15, "color": "@gloss", "action": "previous_page" },
    "bocchi-page-next": { "type": "icon", "icon": "chevron-right", "size": 9, "height": 15, "color": "@gloss", "action": "next_page" },

    "bocchi-pager": {
      "type": "frame", "when": "page", "margin": [0, 0, 0, "auto"], "align_self": "center", "gap": 4,
      "children": [
        { "type": "use", "component": "bocchi-pager-previous", "when": "page.previous" },
        { "type": "use", "component": "bocchi-pager-previous", "when": "!page.previous", "opacity": 0.4 },
        { "type": "use", "component": "bocchi-pager-next", "when": "page.next" },
        { "type": "use", "component": "bocchi-pager-next", "when": "!page.next", "opacity": 0.4 }
      ]
    },
    "bocchi-pager-previous": { "type": "frame", "width": 20, "height": 28, "padding": [7, 3, 7, 3], "radius": 10, "fill": "#f9c9d4", "action": "previous_page", "children": [
      { "type": "frame", "width": 14, "height": 14, "fill": { "image": "images/chevron-left.svg" } }
    ] },
    "bocchi-pager-next": { "type": "frame", "width": 20, "height": 28, "padding": [7, 3, 7, 3], "radius": 10, "fill": "#f9c9d4", "action": "next_page", "children": [
      { "type": "frame", "width": 14, "height": 14, "fill": { "image": "images/chevron-right.svg" } }
    ] },

    "bocchi-status-cell": {
      "type": "frame",
      "children": [
        { "type": "frame", "when": "first", "height": 30, "padding": [6, 9, 6, 9], "margin": [0, 4, 0, 0], "radius": 10, "fill": "#f9c9d4",
          "children": [
            { "type": "text", "text": "中", "when": "!mode.english", "font": "status", "color": "@ink" },
            { "type": "text", "text": "英", "when": "mode.english", "font": "status", "color": "@ink" }
          ] },
        { "type": "frame", "when": "!first", "children": [
          { "type": "frame", "when": "!gear", "children": [
            { "type": "frame", "height": 30, "padding": [6, 8, 6, 8], "margin": [0, 4, 0, 4], "children": [
              { "type": "text", "bind": "text", "font": "status",
                "color": { "if": "emphasized", "then": "@ink", "else": "#a8919b" } }
            ] },
            { "type": "frame", "height": 30, "padding": [5, 8, 5, 8], "margin": [0, 4, 0, 4], "children": [
              { "type": "frame", "width": 20, "height": 20, "fill": { "image": "images/keyboard.svg" } }
            ] }
          ] }
        ] },
        { "type": "frame", "when": "gear", "height": 30, "padding": [5, 8, 5, 8], "margin": [0, 0, 0, 4], "children": [
          { "type": "frame", "width": 20, "height": 20, "fill": { "image": "images/settings.svg" } }
        ] }
      ]
    }
  },

  "windows": {
    "horizontal": {
      "type": "frame", "direction": "column", "padding": [12, 20, 14, 20], "min_width": 440, "radius": 20,
      "fill": "#f5b8c5",
      "border": { "width": 1.25, "color": "#754d56" },
      "effects": [{ "type": "drop-shadow", "y": 5, "blur": 12, "color": "#a0596c38" }],
      "children": [
        { "type": "frame", "position": "absolute", "inset": [-30, -22.5, -30, -22.5], "fill": { "image": "images/audio-cable.svg" } },
        { "type": "use", "component": "bocchi-layers" },

        { "type": "frame", "padding": [2, 0, 6, 6], "align_self": "stretch", "children": [
          { "type": "use", "component": "bocchi-preedit", "when": "preedit" },
          { "type": "frame", "when": "preedit", "width": 1, "height": 16, "fill": "@divider", "margin": [5, 10, 0, 10] },
          { "type": "use", "component": "bocchi-mode", "margin": [5, 0, 0, 0] },
          { "type": "use", "component": "bocchi-trailing", "when": "trailing", "margin": [5, 0, 0, 14] }
        ] },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "margin": [2, 0, 0, 0], "children": [
          { "type": "repeat", "bind": "candidates", "component": "bocchi-item" },
          { "type": "use", "component": "bocchi-pager" }
        ] },

        { "type": "frame", "position": "absolute", "inset": [-58, "auto", "auto", 44], "width": 62, "height": 53,
          "fill": { "image": "images/amp.png", "scale": 2 } },
        { "type": "frame", "position": "absolute", "inset": [-115, 40, "auto", "auto"], "width": 266, "height": 125,
          "fill": { "image": "images/girl-top.png", "scale": 2 } },
        { "type": "frame", "position": "absolute", "inset": [-8, "auto", "auto", 92], "width": 18, "height": 18,
          "fill": { "image": "images/star.svg" } },
        { "type": "frame", "position": "absolute", "inset": [28, "auto", "auto", -15], "width": 28, "height": 32,
          "fill": { "image": "images/pick.svg" } },
        { "type": "frame", "position": "absolute", "inset": ["auto", 2, -9, "auto"], "width": 18, "height": 18,
          "fill": { "image": "images/star.svg" } },
        { "type": "use", "component": "bocchi-note", "position": "absolute", "inset": [12, 120, "auto", "auto"] },
        { "type": "frame", "position": "absolute", "inset": [10, 160, "auto", "auto"], "width": 9, "height": 9,
          "fill": { "image": "images/star-pink.svg" } }
      ]
    },

    "vertical": {
      "type": "frame", "direction": "column", "padding": [14, 16, 16, 14], "min_width": 180, "radius": 18,
      "fill": "#f5b8c5",
      "border": { "width": 1.25, "color": "#754d56" },
      "effects": [{ "type": "drop-shadow", "y": 5, "blur": 12, "color": "#a0596c38" }],
      "children": [
        { "type": "use", "component": "bocchi-layers", "radius": 15.5 },

        { "type": "frame", "padding": [2, 0, 2, 6], "align_self": "stretch", "children": [
          { "type": "use", "component": "bocchi-preedit", "when": "preedit" }
        ] },
        { "type": "frame", "padding": [0, 0, 6, 6], "align_self": "stretch", "children": [
          { "type": "use", "component": "bocchi-trailing", "when": "trailing" },
          { "type": "use", "component": "bocchi-mode", "margin": [0, 0, 0, "auto"] }
        ] },
        { "type": "frame", "when": "candidates", "direction": "column", "align_self": "stretch", "gap": 2, "children": [
          { "type": "repeat", "bind": "candidates", "component": "bocchi-row" }
        ] },
        { "type": "frame", "when": "page", "gap": 3, "align_self": "end", "margin": [4, 6, 0, 0], "children": [
          { "type": "use", "component": "bocchi-page-previous", "when": "page.previous" },
          { "type": "use", "component": "bocchi-page-previous", "when": "!page.previous", "opacity": 0.4 },
          { "type": "text", "bind": "page", "font": "annotation", "color": "@gloss" },
          { "type": "use", "component": "bocchi-page-next", "when": "page.next" },
          { "type": "use", "component": "bocchi-page-next", "when": "!page.next", "opacity": 0.4 }
        ] },

        { "type": "frame", "position": "absolute", "inset": [24, "auto", "auto", -95], "width": 100, "height": 255,
          "fill": { "image": "images/girl-side.png", "scale": 2 } },
        { "type": "frame", "position": "absolute", "inset": [-12, -16, "auto", "auto"], "width": 28, "height": 32,
          "fill": { "image": "images/pick.svg" } },
        { "type": "frame", "when": "candidates", "position": "absolute", "inset": [32, 14, "auto", "auto"], "width": 9, "height": 9,
          "fill": { "image": "images/star-pink.svg" } },
        { "type": "use", "when": "candidates", "component": "bocchi-note", "width": 12, "height": 12, "position": "absolute", "inset": [64, 12, "auto", "auto"] },
        { "type": "frame", "when": "candidates", "position": "absolute", "inset": ["auto", 10, 44, "auto"], "width": 13, "height": 13,
          "fill": { "image": "images/note-gold.svg" } }
      ]
    }
  },

  // 点击按格分区，键盘算第二格；左边纸箱里的人物点到也算第一格
  "status": {
    "root": {
      "type": "frame", "padding": [6, 14, 6, 14], "radius": 20,
      "fill": "#f5b8c5",
      "border": { "width": 1.25, "color": "#754d56" },
      "effects": [{ "type": "drop-shadow", "y": 3, "blur": 8, "color": "#a0596c38" }],
      "children": [
        { "type": "use", "component": "bocchi-layers", "radius": 17 },
        { "type": "frame", "position": "absolute", "inset": ["auto", "auto", -6, -104], "width": 110, "height": 67,
          "fill": { "image": "images/girl-box.png", "scale": 2 } },
        { "type": "frame", "position": "absolute", "inset": [-10, -8, "auto", "auto"], "width": 22, "height": 25,
          "fill": { "image": "images/pick.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-9, "auto", "auto", 90], "width": 14, "height": 14,
          "fill": { "image": "images/star.svg" } },
        { "type": "repeat", "bind": "cells", "component": "bocchi-status-cell" }
      ]
    }
  }
}
