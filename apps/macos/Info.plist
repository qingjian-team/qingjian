<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleExecutable</key>
	<string>qingjian-macos</string>
	<key>CFBundleIdentifier</key>
	<string>app.qingjian.inputmethod</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Qingjian</string>
	<key>CFBundleDisplayName</key>
	<string>青简</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>Qingjian</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- InputMethodKit：连接名按 10.7 起的约定必须是 <bundle id>_Connection -->
	<key>InputMethodConnectionName</key>
	<string>app.qingjian.inputmethod_Connection</string>
	<!-- 与 controller.rs 里 define_class! 的 #[name] 一致 -->
	<key>InputMethodServerControllerClass</key>
	<string>QingjianInputController</string>
	<key>InputMethodType</key>
	<string>Keyboard</string>

	<!-- Text Input Sources：系统「输入法」列表里的身份 -->
	<key>TISInputSourceID</key>
	<string>app.qingjian.inputmethod</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<key>tsInputMethodIconFileKey</key>
	<string>qingjian-menu.tiff</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
		<string>Latn</string>
	</array>

	<!-- 输入模式声明：标准文本视图（备忘录等）按 script / 模式过滤输入源，扁平声明（没有这个键）在这些视图里
	会话会被立即拆除、表现为「切换不过去」，系统设置「添加输入法」列表里也不显示青简，自动启用失败后用户没有
	兜底路径（#31）。单模式 Hans、script 用 smUnicodeScript，与鼠须管等主流输入法一致 -->
	<key>tsInputModeListKey</key>
	<dict>
		<key>app.qingjian.inputmethod.Hans</key>
		<dict>
			<key>TISInputSourceID</key>
			<string>app.qingjian.inputmethod.Hans</string>
			<key>TISIntendedLanguage</key>
			<string>zh-Hans</string>
			<key>tsInputModeCharacterRepertoireKey</key>
			<array>
				<string>Hans</string>
			</array>
			<key>tsInputModeDefaultStateKey</key>
			<true/>
			<key>tsInputModeIsVisibleKey</key>
			<true/>
			<key>tsInputModeMenuIconFileKey</key>
			<string>qingjian-menu.tiff</string>
			<key>tsInputModePrimaryInScriptKey</key>
			<true/>
			<key>tsInputModeScriptKey</key>
			<string>smUnicodeScript</string>
		</dict>
	</dict>
</dict>
</plist>
